)


upregulated_enrichment <- run_functional_enrichment(

  gene_vector = upregulated_degs$Gene_ID,

  analysis_name = "Upregulated_DEGs",

  background_vector = background_genes

)


downregulated_enrichment <- run_functional_enrichment(

