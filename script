################################################################################
# FUNCTIONAL ENRICHMENT ANALYSIS OF SIGNIFICANT RICE DEGs
#
# Description:
#   This script reads a DESeq2 results file containing all tested genes,
#   identifies significant differentially expressed genes and performs
#   functional enrichment analysis using g:Profiler.
#
# Analyses:
#   1. All significant DEGs
#   2. Upregulated DEGs
#   3. Downregulated DEGs
#
# Enrichment sources:
#   - GO:BP  Biological Process
#   - GO:CC  Cellular Component
#   - GO:MF  Molecular Function
#   - KEGG   Biological pathways
#
# Significance criteria:
#   Adjusted p-value < 0.05
#   Absolute log2 fold change > 1
#
# Organism:
#   Oryza sativa
################################################################################


# ==============================================================================
# 1. LOAD REQUIRED PACKAGES
# ==============================================================================

library(readr)
library(dplyr)
library(ggplot2)
library(stringr)
library(forcats)
library(gprofiler2)


# Install packages if required:
#
# install.packages(c(
#   "readr",
#   "dplyr",
#   "ggplot2",
#   "stringr",
#   "forcats",
#   "gprofiler2"
# ))


# ==============================================================================
# 2. USER SETTINGS
# ==============================================================================

# Path to the DESeq2 results file containing ALL tested genes.
#
# Expected information:
#   - Gene ID
#   - log2FoldChange
#   - padj
#
# Change this path according to your computer.

input_file <- "data/DESeq2_All_Genes_Results.csv"


# Main output directory

output_directory <- "results/functional_enrichment"


# DEG significance thresholds

padj_cutoff <- 0.05
log2fc_cutoff <- 1


# Number of enriched terms displayed in each GO/KEGG category

top_terms_to_plot <- 10


# g:Profiler organism code for Oryza sativa

gprofiler_organism <- "osativa"


# Create output folders

dir.create(
  output_directory,
  recursive = TRUE,
  showWarnings = FALSE
)

dir.create(
  file.path(output_directory, "tables"),
  recursive = TRUE,
  showWarnings = FALSE
)

dir.create(
  file.path(output_directory, "figures"),
  recursive = TRUE,
  showWarnings = FALSE
)


# ==============================================================================
# 3. READ THE COMPLETE DESEQ2 RESULTS
# ==============================================================================

deg_results <- read_csv(
  input_file,
  show_col_types = FALSE
)


cat("\nInput file loaded successfully.\n")
cat("Total rows in input file:", nrow(deg_results), "\n")
cat("Available columns:\n")
print(colnames(deg_results))


# ==============================================================================
# 4. AUTOMATICALLY IDENTIFY IMPORTANT COLUMNS
# ==============================================================================

# Possible names used for the gene identifier column

possible_gene_columns <- c(
  "Gene_ID",
  "GeneID",
  "gene_id",
  "gene",
  "Gene",
  "Gene_Feature",
  "feature",
  "Row.names"
)


# Possible names used for the log2 fold-change column

possible_log2fc_columns <- c(
  "log2FoldChange",
  "log2FC",
  "Log2FoldChange",
  "logFC",
  "Log2FC"
)


# Possible names used for the adjusted p-value column

possible_padj_columns <- c(
  "padj",
  "adjusted_pvalue",
  "adjusted_p_value",
  "FDR",
  "qvalue",
  "adj.P.Val"
)


# Find the matching column names

gene_column <- intersect(
  possible_gene_columns,
  colnames(deg_results)
)[1]

log2fc_column <- intersect(
  possible_log2fc_columns,
  colnames(deg_results)
)[1]

padj_column <- intersect(
  possible_padj_columns,
  colnames(deg_results)
)[1]


# Stop the script if an essential column is missing

if (is.na(gene_column)) {
  stop(
    paste0(
      "Gene ID column was not found.\n",
      "Rename your gene column as Gene_ID or update ",
      "'possible_gene_columns' in the script."
    )
  )
}


if (is.na(log2fc_column)) {
  stop(
    paste0(
      "log2FoldChange column was not found.\n",
      "Rename the column as log2FoldChange or update ",
      "'possible_log2fc_columns' in the script."
    )
  )
}


if (is.na(padj_column)) {
  stop(
    paste0(
      "Adjusted p-value column was not found.\n",
      "Rename the column as padj or update ",
      "'possible_padj_columns' in the script."
    )
  )
}


cat("\nColumns selected by the script:\n")
cat("Gene ID column:", gene_column, "\n")
cat("log2 fold-change column:", log2fc_column, "\n")
cat("Adjusted p-value column:", padj_column, "\n")


# ==============================================================================
# 5. STANDARDISE THE COLUMN NAMES
# ==============================================================================

deg_results_standardised <- deg_results %>%
  rename(
    Gene_ID = all_of(gene_column),
    log2FoldChange = all_of(log2fc_column),
    padj = all_of(padj_column)
  ) %>%
  mutate(
    Gene_ID = as.character(Gene_ID),
    log2FoldChange = as.numeric(log2FoldChange),
    padj = as.numeric(padj)
  ) %>%
  filter(
    !is.na(Gene_ID),
    Gene_ID != ""
  ) %>%
  distinct(
    Gene_ID,
    .keep_all = TRUE
  )


# ==============================================================================
# 6. IDENTIFY SIGNIFICANT DEGs
# ==============================================================================

significant_degs <- deg_results_standardised %>%
  filter(
    !is.na(padj),
    !is.na(log2FoldChange),
    padj < padj_cutoff,
    abs(log2FoldChange) > log2fc_cutoff
  ) %>%
  mutate(
    Regulation = case_when(
      log2FoldChange > log2fc_cutoff ~ "Upregulated",
      log2FoldChange < -log2fc_cutoff ~ "Downregulated",
      TRUE ~ "Not significant"
    )
  )


upregulated_degs <- significant_degs %>%
  filter(Regulation == "Upregulated")


downregulated_degs <- significant_degs %>%
  filter(Regulation == "Downregulated")


# Print the DEG summary

cat("\n============================================================\n")
cat("DEG SUMMARY\n")
cat("============================================================\n")

cat(
  "Total genes tested:",
  nrow(deg_results_standardised),
  "\n"
)

cat(
  "Significant DEGs:",
  nrow(significant_degs),
  "\n"
)

cat(
  "Upregulated DEGs:",
  nrow(upregulated_degs),
  "\n"
)

cat(
  "Downregulated DEGs:",
  nrow(downregulated_degs),
  "\n"
)


# Stop if no genes pass the significance criteria

if (nrow(significant_degs) == 0) {
  stop(
    paste0(
      "No significant DEGs were identified using padj < ",
      padj_cutoff,
      " and |log2FoldChange| > ",
      log2fc_cutoff,
      "."
    )
  )
}


# ==============================================================================
# 7. SAVE THE FILTERED DEG TABLES
# ==============================================================================

write_csv(
  significant_degs,
  file.path(
    output_directory,
    "tables",
    "All_Significant_DEGs.csv"
  )
)


write_csv(
  upregulated_degs,
  file.path(
    output_directory,
    "tables",
    "Upregulated_Significant_DEGs.csv"
  )
)


write_csv(
  downregulated_degs,
  file.path(
    output_directory,
    "tables",
    "Downregulated_Significant_DEGs.csv"
  )
)


# Save a small DEG summary table

deg_summary <- data.frame(
  Category = c(
    "Total genes tested",
    "All significant DEGs",
    "Upregulated DEGs",
    "Downregulated DEGs"
  ),
  Number_of_Genes = c(
    nrow(deg_results_standardised),
    nrow(significant_degs),
    nrow(upregulated_degs),
    nrow(downregulated_degs)
  )
)


write_csv(
  deg_summary,
  file.path(
    output_directory,
    "tables",
    "DEG_Summary.csv"
  )
)


# ==============================================================================
# 8. PREPARE THE BACKGROUND GENE LIST
# ==============================================================================

# All tested genes are used as the statistical background.
# NA and empty IDs are removed.

background_genes <- deg_results_standardised %>%
  pull(Gene_ID) %>%
  unique() %>%
  na.omit()


# ==============================================================================
# 9. FUNCTION FOR g:PROFILER ENRICHMENT ANALYSIS
# ==============================================================================

run_enrichment <- function(
    gene_list,
    analysis_name,
    background_list
) {

  cat(
    "\nRunning enrichment analysis for:",
    analysis_name,
    "\n"
  )

  # Remove missing and duplicated gene identifiers

  gene_list <- gene_list %>%
    as.character() %>%
    unique() %>%
    na.omit()

  gene_list <- gene_list[gene_list != ""]


  # Enrichment analysis needs a reasonable number of genes

  if (length(gene_list) < 3) {

    warning(
      paste(
        "Fewer than three genes were available for",
        analysis_name,
        "- enrichment analysis was skipped."
      )
    )

    return(NULL)
  }


  # Submit the gene list to g:Profiler

  enrichment_result <- tryCatch(

    gost(
      query = gene_list,
      organism = gprofiler_organism,

      sources = c(
        "GO:BP",
        "GO:CC",
        "GO:MF",
        "KEGG"
      ),

      correction_method = "fdr",

      domain_scope = "custom",

      custom_bg = background_list,

      significant = TRUE,

      evcodes = TRUE,

      user_threshold = 0.05
    ),

    error = function(error_message) {

      message(
        "g:Profiler analysis failed for ",
        analysis_name,
        ": ",
        error_message$message
      )

      return(NULL)
    }
  )


  # Check whether g:Profiler returned results

  if (
    is.null(enrichment_result) ||
    is.null(enrichment_result$result) ||
    nrow(enrichment_result$result) == 0
  ) {

    warning(
      paste(
        "No significant enrichment terms were identified for",
        analysis_name
      )
    )

    return(NULL)
  }


  # Extract and organise the enrichment table

  enrichment_table <- enrichment_result$result %>%
    mutate(
      Analysis = analysis_name,

      Gene_Ratio = intersection_size / query_size,

      Background_Ratio = term_size / effective_domain_size,

      Minus_Log10_Adjusted_P = -log10(p_value),

      Source_Name = recode(
        source,
        "GO:BP" = "GO Biological Process",
        "GO:CC" = "GO Cellular Component",
        "GO:MF" = "GO Molecular Function",
        "KEGG" = "KEGG Pathway"
      )
    )


  # Save the complete enrichment table

  write_csv(
    enrichment_table,
    file.path(
      output_directory,
      "tables",
      paste0(
        analysis_name,
        "_Functional_Enrichment.csv"
      )
    )
  )


  return(enrichment_table)
}


# ==============================================================================
# 10. RUN ENRICHMENT ANALYSIS
# ==============================================================================

all_significant_enrichment <- run_enrichment(
  gene_list = significant_degs$Gene_ID,
  analysis_name = "All_Significant_DEGs",
  background_list = background_genes
)


upregulated_enrichment <- run_enrichment(
  gene_list = upregulated_degs$Gene_ID,
  analysis_name = "Upregulated_DEGs",
  background_list = background_genes
)


downregulated_enrichment <- run_enrichment(
  gene_list = downregulated_degs$Gene_ID,
  analysis_name = "Downregulated_DEGs",
  background_list = background_genes
)


# ==============================================================================
# 11. FUNCTION TO SELECT THE TOP ENRICHED TERMS
# ==============================================================================

select_top_terms <- function(
    enrichment_table,
    number_of_terms = 10
) {

  if (
    is.null(enrichment_table) ||
    nrow(enrichment_table) == 0
  ) {
    return(NULL)
  }


  top_terms <- enrichment_table %>%
    group_by(Source_Name) %>%
    slice_min(
      order_by = p_value,
      n = number_of_terms,
      with_ties = FALSE
    ) %>%
    ungroup() %>%
    mutate(
     Plot_Label = paste0(
    native,          # GO ID or KEGG ID
    "\n",
    term_name
)

Plot_Label = str_wrap(Plot_Label, width = 45)
    )


  return(top_terms)
}


# ==============================================================================
# 12. FUNCTION TO CREATE BAR PLOTS
# ==============================================================================

create_barplot <- function(
    enrichment_table,
    analysis_name
) {

  plot_data <- select_top_terms(
    enrichment_table,
    top_terms_to_plot
  )


  if (is.null(plot_data)) {
    return(NULL)
  }


  bar_plot <- ggplot(
    plot_data,
    aes(
      x = Minus_Log10_Adjusted_P,
      y = reorder(Plot_Label, Minus_Log10_Adjusted_P)
    )
  ) +

    geom_col() +

    facet_wrap(
      ~Source_Name,
      scales = "free_y",
      ncol = 2
    ) +

    labs(
      title = paste(
        "Functional Enrichment:",
        str_replace_all(analysis_name, "_", " ")
      ),
      x = expression(-log[10]("Adjusted p-value")),
      y = NULL
    ) +

    theme_bw(base_size = 12) +

    theme(
      plot.title = element_text(
        face = "bold",
        hjust = 0.5,
        size = 15
      ),

      strip.text = element_text(
        face = "bold"
      ),

      axis.text.y = element_text(
        size = 8
      ),

      panel.grid.major.y = element_blank(),

      panel.grid.minor = element_blank()
    )


  # Save PNG version

  ggsave(
    filename = file.path(
      output_directory,
      "figures",
      paste0(
        analysis_name,
        "_Functional_Enrichment_Barplot.png"
      )
    ),
    plot = bar_plot,
    width = 14,
    height = 11,
    units = "in",
    dpi = 300
  )


  # Save PDF version

  ggsave(
    filename = file.path(
      output_directory,
      "figures",
      paste0(
        analysis_name,
        "_Functional_Enrichment_Barplot.pdf"
      )
    ),
    plot = bar_plot,
    width = 14,
    height = 11,
    units = "in"
  )


  return(bar_plot)
}


# ==============================================================================
# 13. FUNCTION TO CREATE BUBBLE PLOTS
# ==============================================================================

create_bubbleplot <- function(
    enrichment_table,
    analysis_name
) {

  plot_data <- select_top_terms(
    enrichment_table,
    top_terms_to_plot
  )


  if (is.null(plot_data)) {
    return(NULL)
  }


  bubble_plot <- ggplot(
    plot_data,
    aes(
      x = Gene_Ratio,
      y = reorder(Plot_Label, Gene_Ratio),
      size = intersection_size,
      colour = Minus_Log10_Adjusted_P
    )
  ) +

    geom_point(
      alpha = 0.85
    ) +

    facet_wrap(
      ~Source_Name,
      scales = "free_y",
      ncol = 2
    ) +

    scale_size_continuous(
      name = "Gene count"
    ) +

    scale_colour_gradient(
      name = expression(-log[10]("Adjusted p-value")),
      low = "blue",
      high = "red"
    ) +

    labs(
      title = paste(
        "Functional Enrichment:",
        str_replace_all(analysis_name, "_", " ")
      ),
      x = "Gene ratio",
      y = NULL
    ) +

    theme_bw(base_size = 12) +

    theme(
      plot.title = element_text(
        face = "bold",
        hjust = 0.5,
        size = 15
      ),

      strip.text = element_text(
        face = "bold"
      ),

      axis.text.y = element_text(
        size = 8
      ),

      panel.grid.minor = element_blank()
    )


  # Save PNG version

  ggsave(
    filename = file.path(
      output_directory,
      "figures",
      paste0(
        analysis_name,
        "_Functional_Enrichment_Bubbleplot.png"
      )
    ),
    plot = bubble_plot,
    width = 14,
    height = 11,
    units = "in",
    dpi = 300
  )


  # Save PDF version

  ggsave(
    filename = file.path(
      output_directory,
      "figures",
      paste0(
        analysis_name,
        "_Functional_Enrichment_Bubbleplot.pdf"
      )
    ),
    plot = bubble_plot,
    width = 14,
    height = 11,
    units = "in"
  )


  return(bubble_plot)
}


