# ==============================================================================
# 18. EXPORT TOP-10 TERMS USED IN THE FIGURES
# ==============================================================================

export_top_terms <- function(
    enrichment_data,
    analysis_name
) {

  if (
    is.null(enrichment_data) ||
    nrow(enrichment_data) == 0
  ) {

    return(invisible(NULL))
  }


  source_mapping <- tibble::tribble(

    ~Source, ~File_Label,

    "GO:BP", "GO_BP",

    "GO:CC", "GO_CC",

    "GO:MF", "GO_MF",

    "KEGG", "KEGG"

  )


  for (
    mapping_index in seq_len(
      nrow(source_mapping)
    )
  ) {

    current_source <- source_mapping$Source[
      mapping_index
    ]

    current_file_label <- source_mapping$File_Label[
      mapping_index
    ]


    top_table <- select_top_enrichment_terms(

      enrichment_data = enrichment_data,

      source_code = current_source,

      top_n = top_terms_to_plot

    )


    if (!is.null(top_table)) {

      top_table_export <- top_table %>%

        dplyr::mutate(
          Plot_Label = as.character(Plot_Label)
        ) %>%

        dplyr::select(
          Analysis,
          GO_KEGG_ID,
          Term_Name,
          Source,
          Gene_Count,
          Query_Size,
          Gene_Ratio,
          Term_Size,
          Background_Ratio,
          Adjusted_P_Value,
          Minus_Log10_Adjusted_P,
          Genes_in_Term,
          dplyr::everything()
        )


      readr::write_csv(

        top_table_export,

        file.path(
          table_directory,
          paste0(
            analysis_name,
            "_",
            current_file_label,
            "_Top",
            top_terms_to_plot,
            "_Terms.csv"
          )
        )

      )

    }

  }


  return(invisible(NULL))
}


