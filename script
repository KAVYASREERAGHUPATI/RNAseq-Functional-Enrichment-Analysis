# ==============================================================================
# 4. HELPER FUNCTION: DETECT COLUMN NAMES
# ==============================================================================

detect_column <- function(
    data,
    possible_names,
    column_description
) {

  # Obtain original column names

  original_names <- colnames(data)


  # Convert names to lowercase for case-insensitive matching

  lowercase_names <- tolower(original_names)
  lowercase_candidates <- tolower(possible_names)


  # Identify exact matches

  matching_position <- match(
    lowercase_candidates,
    lowercase_names
  )

  matching_position <- matching_position[
    !is.na(matching_position)
  ]


  # Stop if no suitable column was identified

  if (length(matching_position) == 0) {

    stop(
      paste0(
        "\nUnable to identify the ",
        column_description,
        " column.\n\n",
        "Available columns:\n",
        paste(original_names, collapse = ", "),
        "\n\nAccepted column names include:\n",
        paste(possible_names, collapse = ", ")
      ),
      call. = FALSE
    )
  }


  # Return the first matching original column name

  return(
    original_names[
      matching_position[1]
    ]
  )
}


# ==============================================================================
# 5. READ THE COMPLETE DESEQ2 RESULTS
# ==============================================================================

if (!file.exists(input_file)) {

  stop(
    paste0(
      "\nInput file not found:\n",
      normalizePath(
        input_file,
        winslash = "/",
        mustWork = FALSE
      ),
      "\n\nPlace the complete DESeq2 results file in the data directory ",
      "or update the input_file path at the beginning of the script."
    ),
    call. = FALSE
  )
}


message("Reading DESeq2 results from: ", input_file)


deseq2_results <- readr::read_csv(
  file = input_file,
  show_col_types = FALSE,
  progress = FALSE
)


if (nrow(deseq2_results) == 0) {

  stop(
    "The input DESeq2 file contains no rows.",
    call. = FALSE
  )
}


# ==============================================================================
# 6. AUTOMATICALLY DETECT REQUIRED COLUMNS
# ==============================================================================

gene_id_column <- detect_column(
  data = deseq2_results,
  possible_names = c(
    "Gene_ID",
    "GeneID",
    "Gene",
    "gene_id",
    "geneid",
    "gene",
    "Feature",
    "Gene_Feature",
    "Row.names",
    "X"
  ),
  column_description = "gene identifier"
)


log2fc_column <- detect_column(
  data = deseq2_results,
  possible_names = c(
    "log2FoldChange",
    "log2FC",
    "logFC",
    "LFC",
    "log2_fold_change",
    "log2foldchange"
  ),
  column_description = "log2 fold-change"
)


padj_column <- detect_column(
  data = deseq2_results,
  possible_names = c(
    "padj",
    "FDR",
    "Adjusted_P_Value",
    "Adjusted.P.Value",
    "adj.P.Val",
    "qvalue",
    "q_value"
  ),
  column_description = "adjusted p-value"
)


message("Detected gene ID column: ", gene_id_column)
message("Detected log2FC column: ", log2fc_column)
message("Detected adjusted p-value column: ", padj_column)


# ==============================================================================
# 7. STANDARDISE THE REQUIRED COLUMNS
# ==============================================================================

deseq2_results_standardised <- deseq2_results %>%

  dplyr::rename(
    Gene_ID = all_of(gene_id_column),
    log2FoldChange = all_of(log2fc_column),
    padj = all_of(padj_column)
  ) %>%

  dplyr::mutate(
    Gene_ID = as.character(Gene_ID),
    log2FoldChange = suppressWarnings(
      as.numeric(log2FoldChange)
    ),
    padj = suppressWarnings(
      as.numeric(padj)
    )
  ) %>%

  dplyr::mutate(
    Gene_ID = stringr::str_trim(Gene_ID)
  ) %>%

  dplyr::filter(
    !is.na(Gene_ID),
    Gene_ID != ""
  ) %>%

  # Retain one result per gene identifier.
  #
  # When duplicate gene IDs occur, the row with the smallest adjusted
  # p-value is retained.

  dplyr::arrange(
    Gene_ID,
    padj
  ) %>%

  dplyr::distinct(
    Gene_ID,
    .keep_all = TRUE
  )


# ==============================================================================
# 8. CREATE THE DESEQ2-TESTED BACKGROUND GENE LIST
# ==============================================================================

# All genes tested during differential expression analysis are used as the
# custom statistical background for g:Profiler.

background_genes <- deseq2_results_standardised %>%

  dplyr::filter(
    !is.na(Gene_ID),
    Gene_ID != ""
  ) %>%

  dplyr::pull(Gene_ID) %>%

  unique()


if (length(background_genes) == 0) {

  stop(
    "No valid gene identifiers were found for the enrichment background.",
    call. = FALSE
  )
}


message(
  "Number of unique DESeq2-tested background genes: ",
  length(background_genes)
)


# ==============================================================================
# 9. IDENTIFY SIGNIFICANT DIFFERENTIALLY EXPRESSED GENES
# ==============================================================================

significant_degs <- deseq2_results_standardised %>%

  dplyr::filter(
    !is.na(padj),
    !is.na(log2FoldChange),
    padj < adjusted_p_value_threshold,
    abs(log2FoldChange) > absolute_log2fc_threshold
  ) %>%

  dplyr::mutate(
    Regulation = dplyr::case_when(
      log2FoldChange > absolute_log2fc_threshold ~ "Upregulated",
      log2FoldChange < -absolute_log2fc_threshold ~ "Downregulated",
      TRUE ~ "Not significant"
    )
  )


upregulated_degs <- significant_degs %>%

  dplyr::filter(
    log2FoldChange > absolute_log2fc_threshold
  )


downregulated_degs <- significant_degs %>%

  dplyr::filter(
    log2FoldChange < -absolute_log2fc_threshold
  )


# ==============================================================================
# 10. CREATE AND EXPORT DEG SUMMARY
# ==============================================================================

deg_summary <- tibble::tibble(

  Category = c(
    "All DESeq2-tested genes",
    "Significant DEGs",
    "Upregulated significant DEGs",
    "Downregulated significant DEGs"
  ),

  Number_of_Genes = c(
    length(background_genes),
    nrow(significant_degs),
    nrow(upregulated_degs),
    nrow(downregulated_degs)
  ),

  Criteria = c(
    "All genes retained in the complete DESeq2 results",
    paste0(
      "padj < ",
      adjusted_p_value_threshold,
      " and |log2FoldChange| > ",
      absolute_log2fc_threshold
    ),
    paste0(
      "padj < ",
      adjusted_p_value_threshold,
      " and log2FoldChange > ",
      absolute_log2fc_threshold
    ),
    paste0(
      "padj < ",
      adjusted_p_value_threshold,
      " and log2FoldChange < -",
      absolute_log2fc_threshold
    )
  )
)


readr::write_csv(
  deg_summary,
  file.path(
    table_directory,
    "DEG_Summary.csv"
  )
)


readr::write_csv(
  deseq2_results_standardised,
  file.path(
    table_directory,
    "All_DESeq2_Tested_Genes.csv"
  )
)


readr::write_csv(
  significant_degs,
  file.path(
    table_directory,
    "All_Significant_DEGs.csv"
  )
)


readr::write_csv(
  upregulated_degs,
  file.path(
    table_directory,
    "Upregulated_Significant_DEGs.csv"
  )
)


readr::write_csv(
  downregulated_degs,
  file.path(
    table_directory,
    "Downregulated_Significant_DEGs.csv"
  )
)


message("Significant DEGs identified: ", nrow(significant_degs))
message("Upregulated DEGs identified: ", nrow(upregulated_degs))
message("Downregulated DEGs identified: ", nrow(downregulated_degs))


# ==============================================================================
# 11. FUNCTION: PERFORM FUNCTIONAL ENRICHMENT
# ==============================================================================

run_functional_enrichment <- function(
    gene_vector,
    analysis_name,
    background_vector
) {

  # Remove missing and duplicated identifiers

  query_genes <- gene_vector %>%
    as.character() %>%
    stringr::str_trim() %>%
    unique()

  query_genes <- query_genes[
    !is.na(query_genes) &
      query_genes != ""
  ]


  # Skip enrichment when no genes are available

  if (length(query_genes) == 0) {

    warning(
      paste0(
        "No valid genes were available for ",
        analysis_name,
        ". Enrichment analysis was skipped."
      ),
      call. = FALSE
    )

    return(NULL)
  }


  message(
    "\nRunning functional enrichment for ",
    analysis_name,
    " using ",
    length(query_genes),
    " genes..."
  )


  # Run g:Profiler enrichment analysis

  enrichment_object <- tryCatch(

    {

      gprofiler2::gost(

        query = query_genes,

        organism = gprofiler_organism,

        ordered_query = FALSE,

        multi_query = FALSE,

        significant = TRUE,

        exclude_iea = FALSE,

        measure_underrepresentation = FALSE,

        evcodes = TRUE,

        user_threshold = enrichment_fdr_threshold,

        correction_method = "fdr",

        domain_scope = "custom_annotated",

        custom_bg = background_vector,

        sources = c(
          "GO:BP",
          "GO:CC",
          "GO:MF",
          "KEGG"
        )

      )

    },

    error = function(error_object) {

      warning(
        paste0(
          "g:Profiler failed for ",
          analysis_name,
          ":\n",
          conditionMessage(error_object)
        ),
        call. = FALSE
      )

      return(NULL)
    }

  )


  # Check whether any enrichment result was returned

  if (
    is.null(enrichment_object) ||
    is.null(enrichment_object$result) ||
    nrow(enrichment_object$result) == 0
  ) {

    warning(
      paste0(
        "No significant functional enrichment terms were identified for ",
        analysis_name,
        "."
      ),
      call. = FALSE
    )

    return(NULL)
  }


  enrichment_table <- enrichment_object$result


  # Confirm required output columns are present

  required_result_columns <- c(
    "source",
    "native",
    "name",
    "p_value",
    "term_size",
    "query_size",
    "intersection_size"
  )


  unavailable_columns <- setdiff(
    required_result_columns,
    colnames(enrichment_table)
  )


  if (length(unavailable_columns) > 0) {

    stop(
      paste0(
        "The g:Profiler output for ",
        analysis_name,
        " is missing these required columns: ",
        paste(unavailable_columns, collapse = ", ")
      ),
      call. = FALSE
    )
  }


  # The g:Profiler output column called p_value contains the multiple-testing
  # corrected enrichment significance when correction_method is specified.
  #
  # It is therefore renamed to Adjusted_P_Value in the exported table.

  enrichment_table <- enrichment_table %>%

    dplyr::mutate(

      Analysis = analysis_name,

      GO_KEGG_ID = as.character(native),

      Term_Name = as.character(name),

      Source = as.character(source),

      Adjusted_P_Value = as.numeric(p_value),

      Minus_Log10_Adjusted_P = -log10(
        pmax(
          as.numeric(p_value),
          .Machine$double.xmin
        )
      ),

      Gene_Count = as.numeric(intersection_size),

      Query_Size = as.numeric(query_size),

      Term_Size = as.numeric(term_size),

      Gene_Ratio = dplyr::if_else(
        Query_Size > 0,
        Gene_Count / Query_Size,
        NA_real_
      ),

      Background_Ratio = dplyr::if_else(
        !is.na(effective_domain_size) &
          effective_domain_size > 0,
        Term_Size / effective_domain_size,
        NA_real_
      ),

      Plot_Label = paste0(
        GO_KEGG_ID,
        " - ",
        Term_Name
      )

    )


  # Convert intersecting genes into a semicolon-separated field.
  #
  # Depending on the gprofiler2 version, the intersection column can be a
  # list-column or a character column.

  if ("intersection" %in% colnames(enrichment_table)) {

    enrichment_table <- enrichment_table %>%

      dplyr::mutate(

        Genes_in_Term = vapply(

          intersection,

          FUN = function(gene_entry) {

            if (is.null(gene_entry)) {
              return(NA_character_)
            }

            if (length(gene_entry) == 0) {
              return(NA_character_)
            }

            paste(
              as.character(gene_entry),
              collapse = "; "
            )
          },

          FUN.VALUE = character(1)

        )

      )

  } else {

    enrichment_table$Genes_in_Term <- NA_character_

  }


  # Arrange the results by source and statistical significance

  enrichment_table <- enrichment_table %>%

    dplyr::arrange(
      Source,
      Adjusted_P_Value
    )


  # Create a publication-friendly enrichment table

  export_table <- enrichment_table %>%

    dplyr::select(
      Analysis,
      GO_KEGG_ID,
      Term_Name,
      Source,
      Gene_Count,
      Query_Size,
      Gene_Ratio,
      Term_Size,
      Background_Ratio,
      Adjusted_P_Value,
      Minus_Log10_Adjusted_P,
      Genes_in_Term,
      dplyr::everything()
    )


  # Save the complete enrichment results

  readr::write_csv(
    export_table,
    file.path(
      table_directory,
      paste0(
        analysis_name,
        "_Complete_Functional_Enrichment.csv"
      )
    )
  )


  # Save separate GO and KEGG category tables

  enrichment_sources <- c(
    "GO:BP",
    "GO:CC",
    "GO:MF",
    "KEGG"
  )


  source_file_labels <- c(
    "GO_BP",
    "GO_CC",
    "GO_MF",
    "KEGG"
  )


  for (source_index in seq_along(enrichment_sources)) {

    current_source <- enrichment_sources[source_index]
    current_file_label <- source_file_labels[source_index]


    category_table <- export_table %>%

      dplyr::filter(
        Source == current_source
      )


    if (nrow(category_table) > 0) {

      readr::write_csv(
        category_table,
        file.path(
          table_directory,
          paste0(
            analysis_name,
            "_",
            current_file_label,
            "_Enrichment.csv"
          )
        )
      )

    }

  }


  return(enrichment_table)
}


# ==============================================================================
# 12. RUN ENRICHMENT FOR ALL THREE DEG GROUPS
# ==============================================================================

all_significant_enrichment <- run_functional_enrichment(

  gene_vector = significant_degs$Gene_ID,

