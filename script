# ==============================================================================
# 13. FUNCTION: SELECT THE TOP ENRICHED TERMS
# ==============================================================================

select_top_enrichment_terms <- function(
    enrichment_data,
    source_code,
    top_n = 10
) {

  if (
    is.null(enrichment_data) ||
    nrow(enrichment_data) == 0
  ) {

    return(NULL)

  }


  top_terms <- enrichment_data %>%

    dplyr::filter(
      Source == source_code,
      !is.na(Adjusted_P_Value),
      Adjusted_P_Value <= enrichment_fdr_threshold
    ) %>%

    dplyr::arrange(
      Adjusted_P_Value,
      dplyr::desc(Gene_Count)
    ) %>%

    dplyr::slice_head(
      n = top_n
    ) %>%

    dplyr::mutate(

      Plot_Label = paste0(
        GO_KEGG_ID,
        " - ",
        Term_Name
      ),

      Plot_Label = stringr::str_wrap(
        Plot_Label,
        width = 48
      )

    )


  if (nrow(top_terms) == 0) {

    return(NULL)

  }


  # Preserve the significance-based ordering in the plot.
  #
  # The first term in the table is the most statistically significant.
  # Reversing factor levels places it at the top of the horizontal figure.

  top_terms <- top_terms %>%

    dplyr::mutate(

      Plot_Label = factor(
        Plot_Label,
        levels = rev(unique(Plot_Label))
      )

    )


  return(top_terms)
}


# ==============================================================================
# 14. FUNCTION: CREATE A TOP-10 ENRICHMENT BAR PLOT
# ==============================================================================

create_enrichment_barplot <- function(
    enrichment_data,
    analysis_name,
    source_code,
    source_title,
    output_file_label,
    top_n = 10
) {

  plot_data <- select_top_enrichment_terms(

    enrichment_data = enrichment_data,

    source_code = source_code,

    top_n = top_n

  )


  if (is.null(plot_data)) {

    message(
      "No significant ",
      source_title,
      " terms were available for the ",
      analysis_name,
      " bar plot."
    )

    return(NULL)
  }


  bar_plot <- ggplot2::ggplot(

    data = plot_data,

    mapping = ggplot2::aes(
      x = Minus_Log10_Adjusted_P,
      y = Plot_Label,
      fill = Adjusted_P_Value
    )

  ) +

    ggplot2::geom_col(
      width = 0.72
    ) +

    ggplot2::scale_fill_viridis_c(

      option = "viridis",

      direction = -1,

      name = "Adjusted\np-value",

      labels = scales::label_scientific(
        digits = 2
      )

    ) +

    ggplot2::labs(

      title = paste0(
        "Top ",
        top_n,
        " Enriched Terms\n",
        source_title,
        " (",
        analysis_name,
        ")"
      ),

      x = expression(
        -log[10]("Adjusted P-value")
      ),

      y = "Enriched Terms"

    ) +

    ggplot2::theme_classic(
      base_size = 14
    ) +

    ggplot2::theme(

      plot.title = ggplot2::element_text(
        face = "bold",
        size = 18,
        hjust = 0.5,
        margin = ggplot2::margin(
          b = 12
        )
      ),

      axis.title.x = ggplot2::element_text(
        face = "bold",
        size = 14,
        margin = ggplot2::margin(
          t = 10
        )
      ),

      axis.title.y = ggplot2::element_text(
        face = "bold",
        size = 14,
        margin = ggplot2::margin(
          r = 10
        )
      ),

      axis.text.x = ggplot2::element_text(
        size = 12,
        colour = "black"
      ),

      axis.text.y = ggplot2::element_text(
        size = 11,
        colour = "black"
      ),

      legend.title = ggplot2::element_text(
        face = "bold",
        size = 11
      ),

      legend.text = ggplot2::element_text(
        size = 10
      ),

      legend.position = "right",

      panel.border = ggplot2::element_rect(
        colour = "black",
        fill = NA,
        linewidth = 0.8
      ),

      plot.margin = ggplot2::margin(
        t = 15,
        r = 20,
        b = 15,
        l = 15
      )

    )


  base_filename <- file.path(

    figure_directory,

    paste0(
      analysis_name,
      "_",
      output_file_label,
      "_Top",
      top_n,
      "_Barplot"
    )

  )


  # Save PNG

  ggplot2::ggsave(

    filename = paste0(
      base_filename,
      ".png"
    ),

    plot = bar_plot,

    width = plot_width,

    height = plot_height,

    units = "in",

    dpi = plot_resolution,

    bg = "white"

  )


  # Save PDF

  ggplot2::ggsave(

    filename = paste0(
      base_filename,
      ".pdf"
    ),

    plot = bar_plot,

    width = plot_width,

    height = plot_height,

    units = "in",

    bg = "white",

    device = cairo_pdf

  )


  # Save SVG

  ggplot2::ggsave(

    filename = paste0(
      base_filename,
      ".svg"
    ),

    plot = bar_plot,

    width = plot_width,

    height = plot_height,

    units = "in",

    bg = "white",

    device = svglite::svglite

  )


  return(bar_plot)
}


# ==============================================================================
# 15. FUNCTION: CREATE A TOP-10 ENRICHMENT BUBBLE PLOT
# ==============================================================================

create_enrichment_bubbleplot <- function(
    enrichment_data,
    analysis_name,
    source_code,
    source_title,
    output_file_label,
    top_n = 10
) {

  plot_data <- select_top_enrichment_terms(

    enrichment_data = enrichment_data,

    source_code = source_code,

    top_n = top_n

  )


  if (is.null(plot_data)) {

    message(
      "No significant ",
      source_title,
      " terms were available for the ",
      analysis_name,
      " bubble plot."
    )

    return(NULL)
  }


  # The bubble plot follows the requested design:
  #
  # x-axis:
  #   -log10 adjusted p-value
  #
  # y-axis:
  #   enriched GO or KEGG terms
  #
  # bubble size:
  #   number of input genes associated with the enriched term
  #
  # bubble colour:
  #   adjusted enrichment p-value

  bubble_plot <- ggplot2::ggplot(

    data = plot_data,

    mapping = ggplot2::aes(

      x = Minus_Log10_Adjusted_P,

      y = Plot_Label,

      size = Gene_Count,

      colour = Adjusted_P_Value

    )

  ) +

    ggplot2::geom_point(
      alpha = 0.90
    ) +

    ggplot2::scale_colour_viridis_c(

      option = "viridis",

      direction = -1,

      name = "Adjusted\np-value",

      labels = scales::label_scientific(
        digits = 2
      )

    ) +

    ggplot2::scale_size_continuous(

      name = "Gene count",

      range = c(
        4,
        14
      ),

      breaks = scales::breaks_pretty(
        n = 5
      )

    ) +

    ggplot2::labs(

      title = paste0(
        "Top ",
        top_n,
        " Enriched Terms\n",
        source_title,
        " (",
        analysis_name,
        ")"
      ),

      x = expression(
        -log[10]("Adjusted P-value")
      ),

      y = "Enriched Terms"

    ) +

    ggplot2::theme_classic(
      base_size = 14
    ) +

    ggplot2::theme(

      plot.title = ggplot2::element_text(
        face = "bold",
        size = 18,
        hjust = 0.5,
        margin = ggplot2::margin(
          b = 12
        )
      ),

      axis.title.x = ggplot2::element_text(
        face = "bold",
        size = 14,
        margin = ggplot2::margin(
          t = 10
        )
      ),

      axis.title.y = ggplot2::element_text(
        face = "bold",
        size = 14,
        margin = ggplot2::margin(
          r = 10
        )
      ),

      axis.text.x = ggplot2::element_text(
        size = 12,
        colour = "black"
      ),

      axis.text.y = ggplot2::element_text(
        size = 11,
        colour = "black"
      ),

      legend.title = ggplot2::element_text(
        face = "bold",
        size = 11
      ),

      legend.text = ggplot2::element_text(
        size = 10
      ),

      legend.position = "right",

      panel.border = ggplot2::element_rect(
        colour = "black",
        fill = NA,
        linewidth = 0.8
      ),

      plot.margin = ggplot2::margin(
        t = 15,
        r = 20,
        b = 15,
        l = 15
      )

    )


  base_filename <- file.path(

    figure_directory,

    paste0(
      analysis_name,
      "_",
      output_file_label,
      "_Top",
      top_n,
      "_Bubbleplot"
    )

  )


  # Save PNG

  ggplot2::ggsave(

    filename = paste0(
      base_filename,
      ".png"
    ),

    plot = bubble_plot,

    width = plot_width,

    height = plot_height,

    units = "in",

    dpi = plot_resolution,

    bg = "white"

  )


  # Save PDF

  ggplot2::ggsave(

    filename = paste0(
      base_filename,
      ".pdf"
    ),

    plot = bubble_plot,

    width = plot_width,

    height = plot_height,

    units = "in",

    bg = "white",

    device = cairo_pdf

  )


  # Save SVG

  ggplot2::ggsave(

    filename = paste0(
      base_filename,
      ".svg"
    ),

    plot = bubble_plot,

    width = plot_width,

    height = plot_height,

    units = "in",

    bg = "white",

    device = svglite::svglite

  )


  return(bubble_plot)
}


# ==============================================================================
# 16. FUNCTION: CREATE ALL GO AND KEGG PLOTS FOR ONE DEG GROUP
# ==============================================================================

create_all_enrichment_plots <- function(
    enrichment_data,
    analysis_name
) {

  if (
    is.null(enrichment_data) ||
    nrow(enrichment_data) == 0
  ) {

    message(
      "No enrichment plots were generated for ",
      analysis_name,
      " because no significant enrichment results were available."
    )

    return(invisible(NULL))
  }


  enrichment_categories <- tibble::tribble(

    ~source_code, ~source_title, ~file_label,

    "GO:BP", "GO:BP", "GO_BP",

    "GO:CC", "GO:CC", "GO_CC",

    "GO:MF", "GO:MF", "GO_MF",

    "KEGG", "KEGG", "KEGG"

  )


  generated_plots <- list()


  for (
    category_index in seq_len(
      nrow(enrichment_categories)
    )
  ) {

    current_source <- enrichment_categories$source_code[
      category_index
    ]

    current_title <- enrichment_categories$source_title[
      category_index
    ]

    current_file_label <- enrichment_categories$file_label[
      category_index
    ]


    barplot_name <- paste0(
      current_file_label,
      "_barplot"
    )

    bubbleplot_name <- paste0(
      current_file_label,
      "_bubbleplot"
    )


    generated_plots[[barplot_name]] <- create_enrichment_barplot(

      enrichment_data = enrichment_data,

      analysis_name = analysis_name,

      source_code = current_source,

      source_title = current_title,

      output_file_label = current_file_label,

      top_n = top_terms_to_plot

    )


    generated_plots[[bubbleplot_name]] <- create_enrichment_bubbleplot(

      enrichment_data = enrichment_data,

      analysis_name = analysis_name,

      source_code = current_source,

      source_title = current_title,

      output_file_label = current_file_label,

      top_n = top_terms_to_plot

    )

  }


  return(
    invisible(generated_plots)
  )
}


